{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/health/v0.1.0/schema.json#",
  "title": "Health Extension",
  "description": "STAC Health Extension for geospatial epidemic-intelligence datasets (covariates, vectors, hosts, outcomes, and model outputs).",
  "oneOf": [
    {
      "$comment": "STAC Items",
      "allOf": [
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type",
            "properties",
            "assets"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "properties": {
              "allOf": [
                {
                  "required": [
                    "health:data_type"
                  ]
                },
                {
                  "$ref": "#/definitions/fields"
                },
                {
                  "$ref": "#/definitions/item_conditionals"
                }
              ]
            },
            "assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/fields"
              }
            }
          }
        }
      ]
    },
    {
      "$comment": "STAC Collections",
      "type": "object",
      "allOf": [
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "Collection"
            }
          }
        },
        {
          "$ref": "#/definitions/stac_extensions"
        }
      ],
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/definitions/require_any_field"
            },
            {
              "$ref": "#/definitions/fields"
            }
          ]
        },
        {
          "required": [
            "assets"
          ],
          "properties": {
            "assets": {
              "type": "object",
              "not": {
                "additionalProperties": {
                  "not": {
                    "allOf": [
                      {
                        "$ref": "#/definitions/require_any_field"
                      },
                      {
                        "$ref": "#/definitions/fields"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "required": [
            "item_assets"
          ],
          "properties": {
            "item_assets": {
              "type": "object",
              "not": {
                "additionalProperties": {
                  "not": {
                    "allOf": [
                      {
                        "$ref": "#/definitions/require_any_field"
                      },
                      {
                        "$ref": "#/definitions/fields"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "required": [
            "summaries"
          ],
          "properties": {
            "summaries": {
              "$ref": "#/definitions/require_any_field"
            }
          }
        }
      ]
    }
  ],
  "definitions": {
    "stac_extensions": {
      "type": "object",
      "required": [
        "stac_extensions"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "contains": {
            "const": "https://stac-extensions.github.io/health/v0.1.0/schema.json"
          }
        }
      }
    },
    "require_any_field": {
      "anyOf": [
        {"required": ["health:data_type"]},
        {"required": ["health:disease_codes"]},
        {"required": ["health:pathogen_taxon_ids"]},
        {"required": ["health:vector_species"]},
        {"required": ["health:spatial_unit"]},
        {"required": ["health:spatial_unit_version"]},
        {"required": ["health:temporal_resolution"]},
        {"required": ["health:week_system"]},
        {"required": ["health:spatial_coverage"]},
        {"required": ["health:access_level"]},
        {"required": ["health:gdpr_status"]},
        {"required": ["health:data_version"]},
        {"required": ["health:data_source_system"]},
        {"required": ["health:data_as_of"]},
        {"required": ["health:completeness_score"]},
        {"required": ["health:uncertainty_type"]},
        {"required": ["health:keywords"]}
      ]
    },
    "data_type": {
      "type": "string",
      "enum": [
        "case_reports",
        "mortality",
        "incidence_rate",
        "mortality_rate",
        "vector_occurrence",
        "host_distribution",
        "covariate",
        "model_output",
        "environmental_sampling"
      ]
    },
    "fields": {
      "type": "object",
      "properties": {
        "health:data_type": {
          "$ref": "#/definitions/data_type"
        },
        "health:keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "health:disease_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "health:pathogen_taxon_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "health:vector_species": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "health:spatial_unit": {
          "type": "string",
          "minLength": 1
        },
        "health:spatial_unit_version": {
          "type": "string",
          "minLength": 1
        },
        "health:temporal_resolution": {
          "type": "string",
          "enum": [
            "event",
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "annual",
            "multi_year",
            "other"
          ]
        },
        "health:week_system": {
          "type": "string",
          "enum": [
            "iso_8601",
            "ecdc",
            "mmwr"
          ]
        },
        "health:spatial_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "health:access_level": {
          "type": "string",
          "enum": [
            "open",
            "registered",
            "controlled_access",
            "consortium_only"
          ]
        },
        "health:gdpr_status": {
          "type": "string",
          "enum": [
            "open_data",
            "aggregated_published",
            "anonymised",
            "pseudonymised",
            "restricted_identifiable"
          ]
        },
        "health:data_version": {
          "type": "string",
          "minLength": 1
        },
        "health:data_source_system": {
          "type": "string",
          "minLength": 1
        },
        "health:data_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "health:completeness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "health:uncertainty_type": {
          "type": "string",
          "enum": [
            "none",
            "prediction_interval",
            "posterior_variance",
            "ensemble_spread"
          ]
        }
      },
      "patternProperties": {
        "^(?!health:)": {}
      },
      "additionalProperties": false
    },
    "item_conditionals": {
      "allOf": [
        {
          "$comment": "Weekly series require an explicit week numbering system.",
          "if": {
            "properties": {
              "health:temporal_resolution": {
                "const": "weekly"
              }
            },
            "required": [
              "health:temporal_resolution"
            ]
          },
          "then": {
            "required": [
              "health:week_system"
            ]
          }
        }
      ]
    }
  }
}
